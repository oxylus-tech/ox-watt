{
    "name": "@oxylus/data-client",
    "version": "0.1.0",
    "description": "Framework-independent TypeScript data access, schema validation and query primitives.",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/ox-data.js",
    "module": "./dist/ox-data.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/ox-data.js"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && tsc -p tsconfig.build.json && vite build",
        "build-src": "tsc -p tsconfig.build.json && vite build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "ajv": "^8.17.1",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "happy-dom": "^21.0.4",
        "typescript": "^5.8.3",
        "vite": "^6.2.6",
        "vitest": "^3.1.1"
    }
}
