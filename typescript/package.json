{
  "private": false,
  "name": "@ox-watt",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --sort run dev",
    "build": "pnpm -r --sort run build",
    "build-src": "pnpm -r --sort run build-src",
    "test": "pnpm -r --sort run test",
    "test:watch": "pnpm -r --sort --parallel run test:watch",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vitepress": "^1.6.4",
    "vitepress-sidebar": "^1.41.0",
    "vitest": "^3.1.1",
    "vue-tsc": "^3.3.14"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "vite-plugin-static-copy": "^3.1.4"
  }
}
