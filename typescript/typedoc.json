{
    "entryPoints": [
        "packages/ox-watt/src/index.ts",
    ],
    "entryPointStrategy": "resolve",
    "plugin": [
        "typedoc-plugin-markdown"
    ],
    "out": "docs/api",
    "entryFileName": "index.md",
    "readme": "none",
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "categorizeByGroup": true,
    "navigation": {
        "includeCategories": true,
        "includeGroups": true
    }
}

