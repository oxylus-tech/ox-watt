{
    "name": "ox-watt",
    "version": "0.1.0",
    "description": "Oxylus WebApp Technology Toolkit",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/ox-watt.js",
    "module": "./dist/ox-watt.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/ox-watt.js"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && tsc -p tsconfig.build.json && vite build",
        "build-src": "tsc -p tsconfig.build.json && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "docs:api": "typedoc",
        "docs:dev": "vitepress dev docs",
        "docs:build": "pnpm docs:api && vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "dependencies": {
        "ajv": "^8.17.1",
        "lodash-es": "^4.18.1",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.18",
        "vuetify": "^4.3.3"
    },
    "devDependencies": {
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/test-utils": "^2.6.0",
        "happy-dom": "^21.0.4",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.14.1",
        "typescript": "^5.8.3",
        "vite": "^6.2.6",
        "vitepress": "^1.6.4",
        "vitepress-sidebar": "^1.41.0",
        "vitest": "^3.1.1"
    }
}
