{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@": ["./src"],
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "tests", "vite.config.ts"]
}
