{
    "name": "ox-watt",
    "version": "0.1.0",
    "description": "Oxylus WebApp Technology Toolkit",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/ox-watt.js",
    "module": "./dist/ox-watt.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/ox-watt.js"
        },
        "./package": {
            "types": "./dist/package.d.ts",
            "import": "./dist/package.js"
        },
        "./vite.config.base": "./dist/vite.config.base.js",
        "./vite-plugin": "./dist/vite-plugin.js"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build && tsc -p ./tsconfig.build.json",
        "build-src": "vite build && tsc -p ./tsconfig.build.json",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.18",
        "vuetify": "^4.3.3"
    },
    "dependencies": {
        "glob": "^14.0.6",
        "lodash-es": "^4.18.1"
    },
    "devDependencies": {
        "vite-plugin-vuetify": "^2.1.3"
    }
}
