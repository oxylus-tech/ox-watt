{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationDir": "./dist/types",
        "emitDeclarationOnly": false,

        "noEmit": false,
        "composite": false,
        "skipLibCheck": true
    },
    "include": [
        "src/vite-plugin.ts",
        "src/vite.config.base.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.spec.ts"
    ]
}
