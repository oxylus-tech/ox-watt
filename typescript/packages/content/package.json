{
    "name": "@ox-watt/content",
    "version": "0.1.0",
    "description": "Oxylus WebApp Technology Toolkit: content edition",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/ox-watt-content.js",
    "module": "./dist/ox-watt-content.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/lib.js"
        },
        "package": {
            "types": "./dist/package.d.ts",
            "import": "./dist/package.js",
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && tsc -p ../../tsconfig.build.json && vite build",
        "build-src": "tsc -p ../../tsconfig.build.json && vite build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "ox-watt": "workspace:*",
        "vue": "^3.5.44",
        "vuetify": "^4.3.3"
    },
    "dependencies": {
        "@tiptap/core": "^3.34.0",
        "@tiptap/extension-link": "^3.34.0",
        "@tiptap/extension-table": "^3.34.0",
        "@tiptap/extension-table-cell": "^3.34.0",
        "@tiptap/extension-table-header": "^3.34.0",
        "@tiptap/extension-table-row": "^3.34.0",
        "@tiptap/extension-text-align": "^3.34.0",
        "@tiptap/extension-underline": "^3.34.0",
        "@tiptap/pm": "^3.34.0",
        "@tiptap/starter-kit": "^3.34.0",
        "@tiptap/vue-3": "^3.34.0",
        "lodash-es": "^4.18.1"
    },
    "devDependencies": {
        "vite-plugin-vuetify": "^2.1.3"
    }
}
